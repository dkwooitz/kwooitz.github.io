// Cloudflare Worker that serves kwooitz.co.za.
// Every push to main deploys from this file. Anything set by hand in the
// dashboard (domains, the workers.dev address) is overwritten by what is here,
// so change these settings in this file, not in the dashboard.
//
// The one exception is the secret SITE_PASSWORD, which lives only in
// Cloudflare (Settings → Variables and Secrets) and survives every deploy.
{
  "name": "kwooitz-github-io",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the password check before any file is served.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "kwooitz.co.za", "custom_domain": true },
    { "pattern": "www.kwooitz.co.za", "custom_domain": true }
  ],
  // One address only: no workers.dev copy and no per-version preview links.
  "workers_dev": false,
  "preview_urls": false
}
